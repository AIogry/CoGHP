{
  "study_id": "navigation_hrm_action",
  "question": "Does the selected vanilla-planner HRM H2L2 truncated executor reproduce on AntMaze Giant and transfer to five other navigation environments?",
  "interpretation": "HRM seed 0 is exploratory. Original CoGHP is an overall-method baseline, not a parameter-matched isolation of recurrence.",
  "metric": {"column": "evaluation/overall_success", "steps": [800000, 900000, 1000000]},
  "protocol": {
    "train_steps": 1000000,
    "log_interval": 5000,
    "eval_interval": 100000,
    "save_interval": 1000000,
    "save_steps": [800000, 900000, 1000000],
    "eval_episodes": 50,
    "eval_temperature": 0,
    "video_episodes": 0,
    "eval_on_cpu": 1,
    "fixed_validation_batch": true,
    "require_deterministic_gpu": true
  },
  "common_agent": {
    "batch_size": 256,
    "discount": 0.99,
    "high_discount": 0.8,
    "low_alpha": 3.0,
    "high_alpha": 3.0,
    "expectile": 0.7,
    "tau": 0.005,
    "num_mixer_blocks": 1,
    "mixer_hidden": 32,
    "causal_mixer": true,
    "action_use_full_subgoal_chain": true,
    "share_mixer_weights": false,
    "separate_action_mixer": false
  },
  "methods": {
    "coghp": {
      "agent": "coghp",
      "seeds": [0, 1, 2],
      "overrides": {}
    },
    "hrm_h2l2_truncated": {
      "agent": "hrm_action_coghp",
      "seeds": [0],
      "overrides": {
        "planner_core_type": "vanilla_coghp",
        "share_actor_core": false,
        "action_core_type": "hrm",
        "action_block_type": "swiglu_rmsnorm",
        "hrm_block_type": "swiglu_rmsnorm",
        "hrm_mixer_intermediate_size": 256,
        "action_hrm_num_layers": 1,
        "action_hrm_mlp_mixer_intermediate_size": 256,
        "action_hrm_h_cycles": 2,
        "action_hrm_l_cycles": 2,
        "action_hrm_bptt": false,
        "action_hrm_is_causal": true,
        "action_hrm_is_mlp_mixer": true,
        "action_hrm_norm_eps": 0.000001,
        "action_hrm_forward_dtype": "float32",
        "train_action_chain_source": "teacher",
        "enable_action_hrm_validation": true
      }
    }
  },
  "environments": {
    "pointmaze-medium-navigate-v0": {"num_subgoals": 1, "subgoal_steps": 25, "feature_dim": 32, "lr": 0.0003},
    "pointmaze-large-navigate-v0": {"num_subgoals": 1, "subgoal_steps": 50, "feature_dim": 32, "lr": 0.0003},
    "pointmaze-giant-navigate-v0": {"num_subgoals": 3, "subgoal_steps": 50, "feature_dim": 32, "lr": 0.00001},
    "antmaze-medium-navigate-v0": {"num_subgoals": 1, "subgoal_steps": 25, "feature_dim": 128, "lr": 0.0003},
    "antmaze-large-navigate-v0": {"num_subgoals": 1, "subgoal_steps": 50, "feature_dim": 128, "lr": 0.0003},
    "antmaze-giant-navigate-v0": {"num_subgoals": 2, "subgoal_steps": 50, "feature_dim": 128, "lr": 0.0003}
  }
}
